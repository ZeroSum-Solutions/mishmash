{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "escaping-plugin",
  "title": "Escaping Plugin",
  "version": "1.0.0",
  "description": "Fixture whose bundled HTML preview references an asset outside its own directory, used to regression-test the duplicate-project cross-directory dependency guard.",
  "license": "MIT",
  "tags": ["sample", "phase1"],
  "od": {
    "kind": "skill",
    "taskKind": "new-generation",
    "useCase": {
      "query": "Generate a {{topic}} brief for {{audience}}."
    },
    "preview": {
      "type": "html",
      "entry": "index.html"
    },
    "inputs": [
      { "name": "topic", "type": "string", "required": true, "label": "Topic" },
      { "name": "audience", "type": "select", "options": ["VC pitch", "general"], "default": "general" }
    ],
    "capabilities": ["prompt:inject"]
  }
}
