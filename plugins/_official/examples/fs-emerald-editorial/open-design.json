{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-fs-emerald-editorial",
  "title": "Write a Brand-Launch Narrative like a Growth Strategy Lead",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "Northwind Design's 'design on your desk' brand-launch narrative: the market moment, the story, and the proof that converts. Built as a decision-grade marketing & GTM deck for marketing team, press.",
  "license": "MIT",
  "author": {
    "name": "zarazhangrui",
    "url": "https://github.com/zarazhangrui"
  },
  "homepage": "https://github.com/zarazhangrui/beautiful-html-templates",
  "plugin": {
    "repo": "https://github.com/zarazhangrui/beautiful-html-templates"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "editorial",
    "magazine",
    "emerald",
    "presentation",
    "ppt",
    "launch",
    "campaign",
    "pipeline",
    "marketing",
    "fs-emerald-editorial",
    "marketing-and-gtm",
    "marketing-gtm",
    "annual-marketing-plan",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "marketing",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "deck"
    },
    "useCase": {
      "query": "Create \"Write a Brand-Launch Narrative like a Growth Strategy Lead\" as a decision-grade Marketing & GTM deck in this template's own visual system. Subject: MishMash's 'design on your desk' brand-launch narrative: the market moment, the story, and the proof that converts. Audience: marketing team, press. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: can the plan connect creative choices to measurable growth.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Write a Brand-Launch Narrative like a Growth Strategy Lead"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "leadership presentation",
          "quarterly review",
          "strategy readout",
          "executive briefing",
          "product launch readout",
          "research recap"
        ],
        "default": "leadership presentation"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "The state of the work ahead",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "The leadership team",
        "default": "a leadership audience"
      },
      {
        "name": "slideCount",
        "label": "Length",
        "type": "select",
        "required": true,
        "options": [
          "8 slides (seed rhythm)",
          "9-12 slides (repeat section masters)",
          "13+ slides (multi-section issue)"
        ],
        "default": "8 slides (seed rhythm)"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "marketing-gtm"
  }
}
