{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-ve-midnight-editorial",
  "title": "Present a Financial Review like a Startup CFO",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "Northwind Design's financial review: runway, burn, and the sustainability plan that keeps the project independent. Built as a decision-grade data & finance deck for board, leadership.",
  "license": "MIT",
  "author": {
    "name": "nicobailon",
    "url": "https://github.com/nicobailon"
  },
  "homepage": "https://github.com/nicobailon/visual-explainer",
  "plugin": {
    "repo": "https://github.com/nicobailon/visual-explainer"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "ppt",
    "presentation",
    "editorial",
    "cinematic",
    "dark",
    "serif",
    "gold",
    "dual-theme",
    "visual-explainer",
    "launch",
    "campaign",
    "pipeline",
    "marketing",
    "ve-midnight-editorial",
    "marketing-and-gtm",
    "data-finance",
    "product-analytics-deck",
    "finance",
    "kpi",
    "metrics",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "finance",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "scroll"
    },
    "useCase": {
      "query": "Create \"Present a Financial Review like a Startup CFO\" as a decision-grade Data, KPI & finance deck in this template's own visual system. Subject: MishMash's financial review: runway, burn, and the sustainability plan that keeps the project independent. Audience: board, leadership. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: does every chart have a decision above it.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Present a Financial Review like a Startup CFO"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "product keynote",
          "engineering review",
          "pitch deck",
          "editorial launch deck",
          "quarterly report"
        ],
        "default": "product keynote"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "What the deck is about",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "Execs, engineers, editors, conference crowd…",
        "default": "a general audience"
      },
      {
        "name": "slideCount",
        "label": "Pages",
        "type": "select",
        "required": true,
        "options": [
          "8-11 pages",
          "10-15 pages"
        ],
        "default": "8-11 pages"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "data-finance"
  }
}
