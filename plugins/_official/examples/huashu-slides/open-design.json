{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-huashu-slides",
  "title": "Tell a Career-Pivot Story like an Executive-Presence Coach",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "A career-pivot story from consultant to product leader — the arc, the proof, and why the next role is the right bet. Built as a decision-grade career deck for hiring manager, mentors.",
  "license": "MIT",
  "author": {
    "name": "花叔 (alchaincyf)",
    "url": "https://github.com/alchaincyf"
  },
  "homepage": "https://github.com/alchaincyf/huashu-design",
  "plugin": {
    "repo": "https://github.com/alchaincyf/huashu-design"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "ppt",
    "presentation",
    "pptx",
    "editorial",
    "huashu",
    "consulting-deliverable",
    "strategy",
    "client",
    "huashu-slides",
    "consulting-delivery",
    "career",
    "year-end-self-review-deck",
    "personal",
    "portfolio",
    "promotion",
    "self-review",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "personal",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "deck"
    },
    "useCase": {
      "query": "Create \"Tell a Career-Pivot Story like an Executive-Presence Coach\" as a decision-grade Career deck in this template's own visual system. Subject: A career-pivot story from consultant to product leader — the arc, the proof, and why the next role is the right bet. Audience: hiring manager, mentors. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: does the evidence make the claim feel earned.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Tell a Career-Pivot Story like an Executive-Presence Coach"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "product launch deck",
          "pitch deck",
          "lecture / course deck",
          "data report deck",
          "brand brochure deck"
        ],
        "default": "product launch deck"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "Your topic, e.g.: The next step in AI design workflows",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "Investors / whole team / conference audience",
        "default": "decision makers"
      },
      {
        "name": "slideCount",
        "label": "Pages",
        "type": "select",
        "required": true,
        "options": [
          "6-8 pages",
          "8-12 pages",
          "12-16 pages",
          "16-20 pages"
        ],
        "default": "8-12 pages"
      },
      {
        "name": "pptxExport",
        "label": "Editable PPTX",
        "type": "select",
        "options": [
          "HTML only",
          "also need editable PPTX"
        ],
        "default": "HTML only"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "career"
  }
}
