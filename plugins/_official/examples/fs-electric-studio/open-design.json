{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-fs-electric-studio",
  "title": "Write a B2B SaaS Sales Proposal like a Tier-1 Enterprise AE",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "Northwind Design as an enterprise design platform: a buyer-forwardable proposal for a design-org's economic buyer — pain, value, ROI, rollout. Built as a decision-grade B2B sales deck for economic buyer, design VP, procurement.",
  "license": "MIT",
  "author": {
    "name": "zarazhangrui",
    "url": "https://github.com/zarazhangrui"
  },
  "homepage": "https://github.com/zarazhangrui/frontend-slides",
  "plugin": {
    "repo": "https://github.com/zarazhangrui/frontend-slides"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "presentation",
    "split-panel",
    "cobalt",
    "bold",
    "manrope",
    "web",
    "ppt",
    "sales",
    "renewal",
    "customer",
    "fs-electric-studio",
    "b2b-sales",
    "b2b-saas-sales-proposal",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "sales",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "deck"
    },
    "useCase": {
      "query": "Create \"Write a B2B SaaS Sales Proposal like a Tier-1 Enterprise AE\" as a decision-grade B2B sales deck in this template's own visual system. Subject: Open Design as an enterprise design platform: a buyer-forwardable proposal for a design-org's economic buyer — pain, value, ROI, rollout. Audience: economic buyer, design VP, procurement. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: can the champion forward this internally without rewriting it.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Write a B2B SaaS Sales Proposal like a Tier-1 Enterprise AE"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "studio / agency capabilities deck",
          "pitch deck",
          "product overview",
          "conference talk",
          "internal presentation"
        ],
        "default": "studio / agency capabilities deck"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "Voltaic Studio capabilities 2026",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "Prospective clients evaluating design partners",
        "default": "a general professional audience"
      },
      {
        "name": "slideCount",
        "label": "Length",
        "type": "select",
        "required": true,
        "options": [
          "short 5-10 slides",
          "medium 10-20 slides",
          "long 20+ slides"
        ],
        "default": "short 5-10 slides"
      },
      {
        "name": "density",
        "label": "Density",
        "type": "select",
        "required": true,
        "options": [
          "low density / speaker-led",
          "high density / reading-first"
        ],
        "default": "low density / speaker-led"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "b2b-sales"
  }
}
