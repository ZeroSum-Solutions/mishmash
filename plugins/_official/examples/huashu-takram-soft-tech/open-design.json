{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-huashu-takram-soft-tech",
  "title": "Build a Buyer-Committee Leave-Behind like an Enterprise Sales Lead",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "Northwind Design procurement & security leave-behind: the one-pager-plus a buying committee can forward and approve internally. Built as a decision-grade B2B sales deck for buying committee, security, procurement.",
  "license": "MIT",
  "author": {
    "name": "花叔 (alchaincyf)",
    "url": "https://github.com/alchaincyf"
  },
  "homepage": "https://github.com/alchaincyf/huashu-design",
  "plugin": {
    "repo": "https://github.com/alchaincyf/huashu-design"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "ppt",
    "presentation",
    "soft-tech",
    "data-viz",
    "nature",
    "radar-chart",
    "huashu",
    "ai",
    "copilot",
    "workflow",
    "huashu-takram-soft-tech",
    "enterprise-ai-literacy",
    "b2b-sales",
    "b2b-saas-sales-proposal",
    "sales",
    "renewal",
    "customer",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "sales",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "deck"
    },
    "useCase": {
      "query": "Create \"Build a Buyer-Committee Leave-Behind like an Enterprise Sales Lead\" as a decision-grade B2B sales deck in this template's own visual system. Subject: Open Design procurement & security leave-behind: the one-pager-plus a buying committee can forward and approve internally. Audience: buying committee, security, procurement. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: can the champion forward this internally without rewriting it.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Build a Buyer-Committee Leave-Behind like an Enterprise Sales Lead"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "product briefing deck",
          "benchmark / research report deck",
          "brand story deck",
          "sustainability / ESG report deck",
          "lecture / studio share deck"
        ],
        "default": "product briefing deck"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "Your topic, e.g.: Ambient sensing network 2026 product launch",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "Clients / investors / research community",
        "default": "decision makers"
      },
      {
        "name": "slideCount",
        "label": "Pages",
        "type": "select",
        "required": true,
        "options": [
          "8 pages",
          "9-10 pages",
          "10-11 pages"
        ],
        "default": "9-10 pages"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "b2b-sales"
  }
}
