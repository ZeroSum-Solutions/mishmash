{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-huashu-golden-circle",
  "title": "Present a Brand-Repositioning Strategy like a Top Consulting Principal",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "A brand-repositioning strategy for a heritage coffee chain — why, how, what — the governing idea and the moves to prove it. Built as a decision-grade consulting deck for client CMO, board.",
  "license": "MIT",
  "author": {
    "name": "花叔 (alchaincyf)",
    "url": "https://github.com/alchaincyf"
  },
  "homepage": "https://github.com/alchaincyf/huashu-design",
  "plugin": {
    "repo": "https://github.com/alchaincyf/huashu-design"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "ppt",
    "presentation",
    "golden-circle",
    "diagram",
    "minimal",
    "ted",
    "huashu",
    "training-deck",
    "workshop",
    "course-module",
    "education",
    "huashu-golden-circle",
    "consulting",
    "consulting-final-deck",
    "strategy",
    "consulting-deliverable",
    "client",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "strategy",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "deck"
    },
    "useCase": {
      "query": "Create \"Present a Brand-Repositioning Strategy like a Top Consulting Principal\" as a decision-grade Consulting deck in this template's own visual system. Subject: A brand-repositioning strategy for a heritage coffee chain — why, how, what — the governing idea and the moves to prove it. Audience: client CMO, board. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: would a client know what to do Monday morning.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Present a Brand-Repositioning Strategy like a Top Consulting Principal"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "methodology / framework deck",
          "TED-style idea talk",
          "brand belief / manifesto deck",
          "strategy keynote",
          "concept explainer deck"
        ],
        "default": "methodology / framework deck"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "Your topic, e.g.: Our product growth methodology",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "Executive team / all-hands / industry talk",
        "default": "a general audience"
      },
      {
        "name": "slideCount",
        "label": "Pages",
        "type": "select",
        "required": true,
        "options": [
          "8 pages",
          "9-10 pages",
          "10-11 pages"
        ],
        "default": "9-10 pages"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "consulting"
  }
}
