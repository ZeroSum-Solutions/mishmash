{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-huashu-bento-insight",
  "title": "Write a Competitive Displacement Deck like a Top Sales Engineer",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "Northwind Design vs closed cloud design tools: a side-by-side displacement case on control, cost (BYOK), and lock-in. Built as a decision-grade B2B sales deck for evaluation committee.",
  "license": "MIT",
  "author": {
    "name": "花叔 (alchaincyf)",
    "url": "https://github.com/alchaincyf"
  },
  "homepage": "https://github.com/alchaincyf/huashu-design",
  "plugin": {
    "repo": "https://github.com/alchaincyf/huashu-design"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "ppt",
    "presentation",
    "bento",
    "keynote",
    "qbr",
    "data-report",
    "minimal",
    "huashu",
    "launch",
    "campaign",
    "pipeline",
    "marketing",
    "huashu-bento-insight",
    "marketing-and-gtm",
    "b2b-sales",
    "b2b-saas-sales-proposal",
    "sales",
    "renewal",
    "customer",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "sales",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "deck"
    },
    "useCase": {
      "query": "Create \"Write a Competitive Displacement Deck like a Top Sales Engineer\" as a decision-grade B2B sales deck in this template's own visual system. Subject: MishMash vs closed cloud design tools: a side-by-side displacement case on control, cost (BYOK), and lock-in. Audience: evaluation committee. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: can the champion forward this internally without rewriting it.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Write a Competitive Displacement Deck like a Top Sales Engineer"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "QBR / business review deck",
          "product feature summary deck",
          "sales results deck",
          "town hall metrics deck",
          "annual report deck"
        ],
        "default": "QBR / business review deck"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "Your topic, e.g.: 2026 Q2 business review",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "Leadership / all-hands / senior clients",
        "default": "leadership"
      },
      {
        "name": "slideCount",
        "label": "Pages",
        "type": "select",
        "required": true,
        "options": [
          "8 pages",
          "9-10 pages",
          "10-11 pages"
        ],
        "default": "9-10 pages"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "b2b-sales"
  }
}
