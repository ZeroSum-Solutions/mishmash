{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-fs-creative-voltage",
  "title": "Write a Seed Pitch like a Top Pre-Seed Founder",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "Northwind Design's seed pitch: the open, local alternative to closed AI design — why now, the wedge, and the ask. Built as a decision-grade fundraising pitch deck for pre-seed & seed VCs.",
  "license": "MIT",
  "author": {
    "name": "zarazhangrui",
    "url": "https://github.com/zarazhangrui"
  },
  "homepage": "https://github.com/zarazhangrui/frontend-slides",
  "plugin": {
    "repo": "https://github.com/zarazhangrui/frontend-slides"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "presentation",
    "retro-modern",
    "neon",
    "halftone",
    "web",
    "ppt",
    "launch",
    "campaign",
    "pipeline",
    "marketing",
    "fs-creative-voltage",
    "marketing-and-gtm",
    "fundraising-pitch",
    "series-a-pitch-deck",
    "finance",
    "pitch-deck",
    "fundraising",
    "investor-deck",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "finance",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "deck"
    },
    "useCase": {
      "query": "Create \"Write a Seed Pitch like a Top Pre-Seed Founder\" as a decision-grade Fundraising pitch deck in this template's own visual system. Subject: MishMash's seed pitch: the open, local alternative to closed AI design — why now, the wedge, and the ask. Audience: pre-seed & seed VCs. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: would an investor know why this is venture-scale and urgent.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Write a Seed Pitch like a Top Pre-Seed Founder"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "product overview",
          "pitch deck",
          "conference talk",
          "campaign / launch deck",
          "internal presentation"
        ],
        "default": "product overview"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "A motion branding toolkit for small teams",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "Brand designers and creative leads",
        "default": "a general professional audience"
      },
      {
        "name": "slideCount",
        "label": "Length",
        "type": "select",
        "required": true,
        "options": [
          "short 5-10 slides",
          "medium 10-20 slides",
          "long 20+ slides"
        ],
        "default": "short 5-10 slides"
      },
      {
        "name": "density",
        "label": "Density",
        "type": "select",
        "required": true,
        "options": [
          "low density / speaker-led",
          "high density / reading-first"
        ],
        "default": "low density / speaker-led"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "fundraising-pitch"
  }
}
