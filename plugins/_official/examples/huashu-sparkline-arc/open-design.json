{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-huashu-sparkline-arc",
  "title": "Write a Revenue-Driver Story like a Board-Level Finance Partner",
  "version": "1.0.0",
  "publishedAt": "2026-06-16T09:32:15Z",
  "description": "Northwind Design's revenue-driver narrative: what actually moves ARR, the leverage points, and the forecast. Built as a decision-grade data & finance deck for board, finance leadership.",
  "license": "MIT",
  "author": {
    "name": "花叔 (alchaincyf)",
    "url": "https://github.com/alchaincyf"
  },
  "homepage": "https://github.com/alchaincyf/huashu-design",
  "plugin": {
    "repo": "https://github.com/alchaincyf/huashu-design"
  },
  "tags": [
    "community",
    "deck",
    "slides",
    "ppt",
    "presentation",
    "sparkline",
    "data-storytelling",
    "duarte",
    "minimal",
    "huashu",
    "launch",
    "campaign",
    "pipeline",
    "marketing",
    "huashu-sparkline-arc",
    "marketing-and-gtm",
    "data-finance",
    "product-analytics-deck",
    "finance",
    "kpi",
    "metrics",
    "decision-deck",
    "commercial-slide-agent"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "finance",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html",
      "motion": "deck"
    },
    "useCase": {
      "query": "Create \"Write a Revenue-Driver Story like a Board-Level Finance Partner\" as a decision-grade Data, KPI & finance deck in this template's own visual system. Subject: Open Design's revenue-driver narrative: what actually moves ARR, the leverage points, and the forecast. Audience: board, finance leadership. First ask only for missing essentials: audience, decision target, source-of-truth materials, deadline, and must-keep numbers. Then produce the slide plan, written slides, visual direction, speaker-ready structure, and a critic pass against this rubric: does every chart have a decision above it.",
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Write a Revenue-Driver Story like a Board-Level Finance Partner"
        }
      ]
    },
    "inputs": [
      {
        "name": "deckType",
        "label": "Deck type",
        "type": "select",
        "required": true,
        "options": [
          "change / transformation narrative deck",
          "data story deck",
          "before-after review deck",
          "product journey deck",
          "keynote structure deck"
        ],
        "default": "change / transformation narrative deck"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "string",
        "required": true,
        "placeholder": "Your topic, e.g.: Customer-service intelligent transformation review",
        "default": "the user's brief"
      },
      {
        "name": "audience",
        "label": "Audience",
        "type": "string",
        "required": true,
        "placeholder": "All-hands / leadership / customer summit",
        "default": "decision makers"
      },
      {
        "name": "slideCount",
        "label": "Pages",
        "type": "select",
        "required": true,
        "options": [
          "8 pages",
          "9-10 pages",
          "10-11 pages"
        ],
        "default": "9-10 pages"
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ],
    "category": "data-finance"
  }
}
